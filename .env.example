# Environment variables

# Required: your Telegram bot token from @BotFather.
# Never commit a real token. Use /revoke in @BotFather if one leaks.
TELEGRAM_BOT_TOKEN=

# Optional: directory where FastF1 caches downloaded data.
# Speeds up repeated requests and reduces network usage.
#F1_CACHE_DIR=~/.cache/fastf1

# Optional: polling behaviour.
#LONG_POLLING=true
#POLLING_TIMEOUT=20

# Optional: verbose logging.
#DEBUG=false